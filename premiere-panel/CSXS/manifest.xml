<?xml version="1.0" encoding="UTF-8"?>
<!--
	Panel „Clipproof“ für Premiere Pro. Eigene Kennung (BundleId noch
	Platzhalter). Laufzeit CSXS 9, Node an, ohne Abschalten der
	Web-Sicherheit. Achtung: In XML-Kommentaren sind zwei Bindestriche
	hintereinander verboten; ein ungültiges Manifest verwirft Premiere
	ohne Meldung.
-->
<ExtensionManifest Version="7.0" ExtensionBundleId="org.clipproof.panel" ExtensionBundleVersion="0.1.5" ExtensionBundleName="Clipproof" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<ExtensionList>
		<Extension Id="org.clipproof.panel.main" Version="0.1.5" />
	</ExtensionList>
	<ExecutionEnvironment>
		<HostList>
			<Host Name="PPRO" Version="[13.0,99.9]" />
		</HostList>
		<LocaleList>
			<Locale Code="All" />
		</LocaleList>
		<RequiredRuntimeList>
			<RequiredRuntime Name="CSXS" Version="9.0" />
		</RequiredRuntimeList>
	</ExecutionEnvironment>
	<DispatchInfoList>
		<Extension Id="org.clipproof.panel.main">
			<DispatchInfo>
				<Resources>
					<MainPath>./index.html</MainPath>
					<ScriptPath>./jsx/host.jsx</ScriptPath>
					<CEFCommandLine>
						<Parameter>--enable-nodejs</Parameter>
						<Parameter>--mixed-context</Parameter>
					</CEFCommandLine>
				</Resources>
				<Lifecycle>
					<AutoVisible>true</AutoVisible>
				</Lifecycle>
				<UI>
					<Type>Panel</Type>
					<Menu>Clipproof</Menu>
					<Geometry>
						<Size>
							<Height>760</Height>
							<Width>380</Width>
						</Size>
						<MinSize>
							<Height>420</Height>
							<Width>300</Width>
						</MinSize>
					</Geometry>
				</UI>
			</DispatchInfo>
		</Extension>
	</DispatchInfoList>
</ExtensionManifest>
