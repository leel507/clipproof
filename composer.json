{
	"name": "clipproof/clipproof",
	"description": "Frame-accurate video review for Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"nextcloud/ocp": "dev-stable33",
		"phpcompatibility/php-compatibility": "^10.0@alpha || ^10.0",
		"phpunit/phpunit": "^11.5",
		"squizlabs/php_codesniffer": "^3.10"
	},
	"autoload": {
		"psr-4": {
			"OCA\\Clipproof\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\Clipproof\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP",
			"NCU\\": "vendor/nextcloud/ocp/NCU"
		}
	},
	"minimum-stability": "alpha",
	"prefer-stable": true,
	"config": {
		"platform": {
			"php": "8.3.31"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"php83": "phpcs --standard=phpcs.xml",
		"test": "phpunit -c phpunit.xml"
	}
}
